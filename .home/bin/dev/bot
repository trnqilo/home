#!/usr/bin/env bash
set -e

resume= bot=${bot:-codex}
if [[ "$1" =~ ^r(esume)?$ && "$bot" == 'claude' ]]; then $bot --resume
elif [[ "$1" =~ ^r(esume)?$ && "$bot" == 'codex' ]]; then $bot resume
elif [[ "$1" =~ ^c(ontinue)?$ && "$bot" == 'claude' ]]; then $bot --continue
elif [[ "$1" =~ ^c(ontinue)?$ && "$bot" == 'codex' ]]; then $bot resume --last
elif [[ "$1" == 'conf' || "$1" == 'init' ]]; then
  agents() { agents="$@"
    cat "$dothome/conf/agents/"*.md > "$agents"
    if [[ -f "$holo/conf/agents.md" ]]; then cat "$holo/conf/agents/"* >> "$agents"; fi;
  }
  if [[ -d "$HOME/.claude" ]]; then agents "$HOME/.claude/CLAUDE.md"; fi
  if [[ -d "$HOME/.codex" ]]; then agents "$HOME/.codex/AGENTS.md"; fi
elif [[ "$1" == 'cc' ]]; then shift; bot=claude bot "$@"
elif [[ "$1" == 'cx' ]]; then shift; bot=codex bot "$@"
else $bot "$@"; fi
