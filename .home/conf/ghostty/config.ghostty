title = " "
macos-titlebar-style = hidden
background-opacity-cells = true
background-blur = macos-glass-clear
shell-integration = none
bell-features = no-title
window-padding-balance = true
window-padding-x = 12
window-padding-y = 12
font-size = 20
cursor-style = block
cursor-style-blink = false
keybind = control+\=new_split:right
keybind = super+\=new_split:right
keybind = control+enter=toggle_split_zoom
keybind = super+enter=toggle_split_zoom
keybind = control+shift+enter=toggle_fullscreen
keybind = super+shift+enter=toggle_fullscreen
keybind = control+shift+\=new_split:down
keybind = super+shift+\=new_split:down
keybind = control+tab=goto_split:next
background = BACKGROUND
foreground = FOREGROUND
background-opacity = OPACITY
background-blur = BLUR
cursor-color = CURSOR
selection-background = SELECTIONBG
selection-foreground = SELECTIONFG
palette = 0=BLACK
palette = 1=RED
palette = 2=GREEN
palette = 3=YELLOW
palette = 4=BLUE
palette = 5=MAGENTA
palette = 6=CYAN
palette = 7=WHITE
palette = 8=BLACK
palette = 9=RED
palette = 10=GREEN
palette = 11=YELLOW
palette = 12=BLUE
palette = 13=MAGENTA
palette = 14=CYAN
palette = 15=WHITE
