title = " "
auto-update = off
background-opacity-cells = true
background-blur = macos-glass-clear
bell-features = no-title
cursor-style = block
cursor-style-blink = false
font-size = 20
macos-titlebar-style = hidden
shell-integration = bash
shell-integration-features = no-cursor
window-padding-balance = true
window-padding-x = 12
window-padding-y = 12
keybind = control+\=new_split:right
keybind = super+\=new_split:right
keybind = control+enter=toggle_split_zoom
keybind = super+enter=toggle_split_zoom
keybind = control+shift+enter=toggle_fullscreen
keybind = super+shift+enter=toggle_fullscreen
keybind = control+shift+\=new_split:down
keybind = super+shift+\=new_split:down
keybind = control+tab=goto_split:next
keybind = control+shift+e=equalize_splits
keybind = super+e=equalize_splits
keybind = control+shift+w=goto_split:top
keybind = control+shift+s=goto_split:bottom
keybind = control+shift+a=goto_split:left
keybind = control+shift+d=goto_split:right
keybind = control+shift+alt+w=resize_split:up,10
keybind = control+shift+alt+s=resize_split:down,10
keybind = control+shift+alt+a=resize_split:left,10
keybind = control+shift+alt+d=resize_split:right,10
keybind = super+alt+up=unbind
keybind = super+alt+down=unbind
keybind = super+alt+left=unbind
keybind = super+alt+right=unbind
keybind = super+control+up=unbind
keybind = super+control+down=unbind
keybind = super+control+left=unbind
keybind = super+control+right=unbind
background = BACKGROUND
foreground = FOREGROUND
background-opacity = OPACITY
background-blur = BLUR
cursor-color = CURSOR
selection-background = SELECTIONBG
selection-foreground = SELECTIONFG
palette = 0=BLACK
palette = 1=RED
palette = 2=GREEN
palette = 3=YELLOW
palette = 4=BLUE
palette = 5=MAGENTA
palette = 6=CYAN
palette = 7=WHITE
palette = 8=BLACK
palette = 9=RED
palette = 10=GREEN
palette = 11=YELLOW
palette = 12=BLUE
palette = 13=MAGENTA
palette = 14=CYAN
palette = 15=WHITE
