#!/usr/bin/env bash
set -e

if type nvidia-smi &>/dev/null; then
  nvidia-smi -q -d CLOCK | grep '  Clocks$' -A4 | grep -iE 'graphics|SM|Memory|Video' | \
  while read clock; do printf "\n${clock/'                   :'/}"; done && echo
fi
if type system_profiler &>/dev/null; then
  echo `system_profiler SPDisplaysDataType | grep 'Total Number of Cores' | $awk '{print $5" x"}'; system_profiler SPDisplaysDataType | grep 'Chipset Model' | $awk '{$1="";$2="";print $0}'`
fi
