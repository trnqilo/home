#   utmctl start "$2" ||:
#   ssh_command="ssh -p ${3:-22} ${4:-$USER}@${5:-192.168.64.2}"
#   until $ssh_command echo; do printf .; sleep 1; done
#   $ssh_commandu
else utmctl start "$1"; fi
