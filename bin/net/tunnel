#!/usr/bin/env bash
set -e

if [[ "$1" =~ ^a(ttach)?$ ]]; then tunnel='ssh -L'; shift
else tunnel='ssh -NL'; fi

host="$1"
port="$2"
dest="${3:-$host}"
local_port="${4:-$port}"

if [[ "$port" && "$local_port" && "$host" && "$dest" ]]; then
  if ! (( 1024 < port )); then sudo=sudo; fi
  echo "tunneling 127.0.0.1:$local_port:$dest:$port $host"
  $sudo $tunnel 127.0.0.1:$local_port:$dest:$port $host
else
  echo 'tunnel host port [dest] [local_port]'
fi

